{
  "name": "kernel-lendefi",
  "version": "3.3.0",
  "license": "MIT",
  "scripts": {
    "compile": "forge build",
    "test": "forge test",
    "test:staking": "forge test --match-path 'test/LendefiStaking.t.sol' -vvv",
    "test:paymaster": "forge test --match-path 'test/LendefiPaymaster.t.sol' -vvv",
    "test:lendefi": "forge test --match-path 'test/Lendefi*.t.sol' -vvv",
    "deploy:kernel": "source .env && forge script script/DeployLendefi.s.sol:DeployKernel --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "deploy:staking": "source .env && forge script script/DeployLendefi.s.sol:DeployLendefiStaking --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "deploy:paymaster": "source .env && forge script script/DeployLendefi.s.sol:DeployLendefiPaymaster --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "deploy:full": "source .env && forge script script/DeployLendefi.s.sol:DeployLendefiFull --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "deploy:all": "source .env && forge script script/DeployLendefi.s.sol:DeployAll --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "upgrade:staking": "source .env && forge script script/DeployLendefi.s.sol:UpgradeLendefiStaking --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "upgrade:paymaster": "source .env && forge script script/DeployLendefi.s.sol:UpgradeLendefiPaymaster --rpc-url $RPC_URL --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY",
    "fund:paymaster": "source .env && forge script script/DeployLendefi.s.sol:FundPaymaster --rpc-url $RPC_URL --broadcast",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-foundry": "^1.1.1",
    "@nomicfoundation/hardhat-ignition": "^3.0.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.7",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.5",
    "chai": "4",
    "ethers": "^6.4.0",
    "hardhat": "^2.22.2",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.8",
    "hardhat-spdx-license-identifier": "^2.2.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.4.4"
  }
}
